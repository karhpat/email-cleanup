# Copy to .env and fill in. Never commit .env.

# Anthropic API key used for the Organize step (classification).
ANTHROPIC_API_KEY=

# Models. Cheapest capable model does the bulk work; the stronger one only
# re-checks low-confidence results.
CLASSIFY_MODEL=claude-haiku-4-5
ESCALATE_MODEL=claude-sonnet-5
ESCALATE_BELOW_CONFIDENCE=0.6

# Set DEMO=1 to run against synthetic data with no Gmail or Anthropic access.
DEMO=0

# Where the local SQLite cache lives.
DATA_DIR=./data

# Port for the local dashboard.
PORT=8765
